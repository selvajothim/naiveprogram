import time
import matplotlib.pyplot as plt

# ============================================================
# PERFORMANCE METRICS CLASS
# ============================================================

class Metrics:

    def __init__(self):

        self.comparisons = 0
        self.execution_time = 0
        self.memory = 0


# ============================================================
# NAIVE PATTERN MATCHING
# ============================================================

def naive_search(text, pattern):

    metrics = Metrics()

    result = []

    n = len(text)
    m = len(pattern)

    start = time.time()

    for i in range(n - m + 1):

        j = 0

        while j < m:

            metrics.comparisons += 1

            if text[i + j] != pattern[j]:
                break

            j += 1

        if j == m:
            result.append(i)

    end = time.time()

    metrics.execution_time = (end - start) * 1000

    metrics.memory = len(text) + len(pattern)

    return result, metrics


# ============================================================
# KMP ALGORITHM
# ============================================================

def compute_lps(pattern):

    lps = [0] * len(pattern)

    length = 0

    i = 1

    while i < len(pattern):

        if pattern[i] == pattern[length]:

            length += 1

            lps[i] = length

            i += 1

        else:

            if length != 0:
                length = lps[length - 1]

            else:
                lps[i] = 0
                i += 1

    return lps


def kmp_search(text, pattern):

    metrics = Metrics()

    result = []

    lps = compute_lps(pattern)

    i = 0
    j = 0

    start = time.time()

    while i < len(text):

        metrics.comparisons += 1

        if pattern[j] == text[i]:

            i += 1
            j += 1

        if j == len(pattern):

            result.append(i - j)

            j = lps[j - 1]

        elif i < len(text) and pattern[j] != text[i]:

            if j != 0:
                j = lps[j - 1]

            else:
                i += 1

    end = time.time()

    metrics.execution_time = (end - start) * 1000

    metrics.memory = len(text) + len(pattern) + len(lps)

    return result, metrics


# ============================================================
# RABIN KARP
# ============================================================

def rabin_karp(text, pattern):

    metrics = Metrics()

    result = []

    d = 256
    q = 101

    n = len(text)
    m = len(pattern)

    h = 1

    pattern_hash = 0
    text_hash = 0

    for i in range(m - 1):
        h = (h * d) % q

    for i in range(m):

        pattern_hash = (
            d * pattern_hash + ord(pattern[i])
        ) % q

        text_hash = (
            d * text_hash + ord(text[i])
        ) % q

    start = time.time()

    for i in range(n - m + 1):

        if pattern_hash == text_hash:

            match = True

            for j in range(m):

                metrics.comparisons += 1

                if text[i + j] != pattern[j]:

                    match = False

                    break

            if match:
                result.append(i)

        if i < n - m:

            text_hash = (
                d * (text_hash - ord(text[i]) * h)
                + ord(text[i + m])
            ) % q

            if text_hash < 0:
                text_hash += q

    end = time.time()

    metrics.execution_time = (end - start) * 1000

    metrics.memory = len(text) + len(pattern)

    return result, metrics


# ============================================================
# BOYER MOORE
# ============================================================

def bad_character_table(pattern):

    table = {}

    for i in range(len(pattern)):
        table[pattern[i]] = i

    return table


def boyer_moore(text, pattern):

    metrics = Metrics()

    result = []

    bad_char = bad_character_table(pattern)

    n = len(text)
    m = len(pattern)

    shift = 0

    start = time.time()

    while shift <= n - m:

        j = m - 1

        while j >= 0 and pattern[j] == text[shift + j]:

            metrics.comparisons += 1

            j -= 1

        if j < 0:

            result.append(shift)

            shift += (
                m - bad_char.get(
                    text[shift + m], -1
                )
                if shift + m < n else 1
            )

        else:

            shift += max(
                1,
                j - bad_char.get(
                    text[shift + j], -1
                )
            )

    end = time.time()

    metrics.execution_time = (end - start) * 1000

    metrics.memory = (
        len(text) + len(pattern) + len(bad_char)
    )

    return result, metrics


